[Unit]
Description=Apply NZXT Kraken and motherboard fan curves
Documentation=https://github.com/hhdri/aioconf
# The motherboard fan driver must be loaded before board.pwm* curves can be written.
After=systemd-modules-load.service
# Also run after waking up: the cooler and the BIOS can both reset the fan curves.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aioconf apply /etc/aioconf.conf
# The device node can appear a moment before it accepts reports.
Restart=on-failure
RestartSec=2

# aioconf reads its config, writes fan curve files in /sys, and talks to one hidraw node.
DevicePolicy=closed
DeviceAllow=char-hidraw rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=none
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@basic-io @file-system @io-event ioctl exit_group

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
